# ─────────────────────────────────────────────────────────────────────
#  Fresh_Approch — local configuration
#
#  Copy this file to  .env  in the same folder and fill in the values.
#  .env is git-ignored and must never be committed.
#
#  The servers read it at startup with a built-in loader — no npm
#  install and no dotenv package required.
# ─────────────────────────────────────────────────────────────────────

# ManipalCigna API gateway credential.
# This is the base64 blob that follows the word "Basic " in the
# Authorization header. It decodes to a client_id:client_secret pair,
# so treat it as a real secret.
MC_AUTH_TOKEN=

# ManipalCigna payload encryption key — exactly 16 characters (AES-128-ECB).
MC_AES_KEY=

# Optional. Only set this if ManipalCigna moves the gateway host.
# MC_GATEWAY=https://online.gateway.manipalcigna.com

# Set to 1 to enable /decrypt and /api/decrypt-test on port 3003.
# These expose the AES key as a decryption oracle to anything that can reach
# the port — leave off unless you are actively reverse-engineering a payload.
# MC_ENABLE_DECRYPT_TOOLS=1
