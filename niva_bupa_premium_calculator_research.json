  "api_behavior_analysis": {
    "http_behavior": "All API requests return HTTP 200. Success/failure is determined by statusCode field inside JSON body ('200' = success, '400' = error)",
    "error_pattern": "Plan not found!. — returned for 17 of 21 products tested",
    "working_pattern": {
      "observation": "Only the two most recently launched products work: ReAssure3.0 (codes 63/64) and Senior First (codes 45/46). These appear to be the currently active products on the OTC portal.",
      "hypothesis": {
        "primary": "The GetPremium API endpoint uses a planId lookup internally. The payload sends planId='0' which is a wildcard — it may only resolve correctly for active/newest products. Older product codes (13, 28, 29, 30, 31, 33, 34, 36, 37, 39, 40, 41, 42, 47, 49, 50, 51, 54, 55, 57, 58, 61, 62) may require a specific non-zero planId obtained from a separate pre-call.",
        "secondary": "Some products (Aspire 57/58, ReAssure2.0 54/55) may be newer products not yet live on the OTC environment at time of testing.",
        "tertiary": "The ProductConfiguration API returns product codes correctly, but GetPremium may be connected to a different product database that has fewer active entries."
      }
    },
    "key_observations": [
      "ReAssure3.0 (63/64) — newest product, works perfectly with planId=0",
      "Senior First (45/46) — dedicated senior product, works perfectly",
      "All other products across all plan types fail with same error",
      "The payload structure itself is correct (no auth errors, no validation errors — pure 'plan not found')",
      "No authentication headers required — the API accepts unauthenticated requests",
      "The billCycle parameter is set to '3' (Annual). Other values: '1'=Annual, '2'=Half-Yearly, '3'=Quarterly(?)",
      "WithRiders:true gives a TotalPremium that differs from BasePremium (includes rider premiums)",
      "GST appears to be included in the premium or returned separately — returned as 0 in tested calls"
    ],
    "recommendations_for_calculator": [
      "For the 4 working products, implement full premium calculation immediately",
      "For other products, the ProductConfiguration data is correct for UI rendering (dropdowns, age limits, SI options)",
      "Consider intercepting actual browser traffic from the live uno.nivabupa.com portal to discover if additional headers or a pre-call endpoint is needed",
      "The premiumCalculationDate must use DD/MM/YYYY format with today's date",
      "For plans with plantype variants, PlanType in planDetails must match the variant value (1, 2, 3...)",
      "For FamilyFirst/Floater plans with 2 adults, Adult2IncomeType must be set (not empty string)",
      "memberDetails array length must match Adult + Child count exactly"
    ]
  },

